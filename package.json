{
  "name": "mother-of-invention",
  "version": "0.1.2",
  "description": "Mechanisms that stimulate novel attempts from model-driven agents. First: precedent, what an observer has already seen tried across episodes. Zero dependencies, no I/O.",
  "license": "MIT",
  "author": "Derek Ferguson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JavaDerek/mother-of-invention.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.51.0",
    "vitest": "^4.0.16"
  },
  "keywords": [
    "novelty",
    "invention",
    "agents",
    "llm",
    "precedent",
    "episodes"
  ],
  "files": [
    "dist/",
    "!dist/**/__tests__/**",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  }
}
